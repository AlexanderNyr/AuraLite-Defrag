{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuraLite-Defrag Scenario Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "seed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "generator": {
      "type": "string",
      "enum": [
        "G-1",
        "G-2",
        "G-3",
        "G-4",
        "G-5",
        "G-6"
      ]
    },
    "volume": {
      "type": "object"
    },
    "mft": {
      "type": "object"
    },
    "files": {
      "type": "object"
    },
    "faults": {
      "type": "array"
    },
    "expected": {
      "type": "object"
    },
    "tolerances": {
      "type": "object"
    }
  }
}
