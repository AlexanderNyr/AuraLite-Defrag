// rc.exe resolves include paths against its own include list, not against the
// directory this file lives in, so these are written from the repository root
// and CMake puts the root on the RC include path.
#include "res/strings/ids.h"
#include "res/strings/en-US.rc"

// The process manifest. rc.exe embeds it as RT_MANIFEST/ID 1, and the linker is
// told /MANIFEST:NO so that it does not also generate one: two RT_MANIFEST
// resources with the same ID is CVT1100 followed by LNK1123.
//
// Requiring elevation, PerMonitorV2 DPI and the Windows 10/11 supportedOS entry
// all live in this file. Without it the app starts unelevated and cannot open a
// volume, and the cluster map is drawn at the wrong scale on a high-DPI screen.
1 RT_MANIFEST "app.manifest"

// Application icon: shows in Explorer and on the taskbar.
IDI_AURALITE_APP ICON "res/assets/auralite.ico"
